{
  "name": "easy-pokedex-v2",
  "version": "0.0.0",
  "private": true,
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "lint": "pnpm -r --workspace-concurrency=1 lint",
    "format": "prettier --write \"**/*.{ts,html,css,json,md,yaml,yml}\"",
    "format:check": "prettier --check \"**/*.{ts,html,css,json,md,yaml,yml}\"",
    "build": "pnpm -r build",
    "test": "pnpm -r test",
    "e2e": "playwright test",
    "e2e:install": "playwright install chromium",
    "dev:web": "pnpm --filter web start",
    "dev:bff": "pnpm --filter bff dev"
  },
  "devDependencies": {
    "@eslint/js": "9.39.4",
    "@playwright/test": "1.60.0",
    "eslint": "9.39.4",
    "globals": "16.5.0",
    "prettier": "3.8.3",
    "typescript": "5.9.3",
    "typescript-eslint": "8.60.1"
  }
}
