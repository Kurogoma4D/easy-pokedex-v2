{
  "name": "bff",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=../../.env src/index.ts",
    "start": "node --env-file-if-exists=../../.env dist/index.js",
    "build": "tsc -p tsconfig.json && node scripts/copy-migrations.js",
    "lint": "eslint .",
    "test": "vitest run",
    "migrate": "tsx --env-file-if-exists=../../.env src/db/migrate-cli.ts",
    "migrate:prod": "node --env-file-if-exists=../../.env dist/db/migrate-cli.js"
  },
  "dependencies": {
    "@hono/node-server": "2.0.4",
    "hono": "4.12.23",
    "postgres": "3.4.9"
  },
  "devDependencies": {
    "@types/node": "22.19.19",
    "tsx": "4.22.4",
    "vitest": "4.1.8"
  }
}
