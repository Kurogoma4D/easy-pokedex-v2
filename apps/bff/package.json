{
  "name": "bff",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=../../.env src/index.ts",
    "start": "node --env-file-if-exists=../../.env dist/index.js",
    "migrate": "tsx --env-file-if-exists=../../.env src/migrate.ts",
    "build": "tsc -p tsconfig.json",
    "lint": "eslint .",
    "test": "vitest run"
  },
  "dependencies": {
    "@hono/node-server": "2.0.4",
    "bcryptjs": "3.0.2",
    "hono": "4.12.23",
    "pg": "8.16.3"
  },
  "devDependencies": {
    "@types/node": "22.19.19",
    "@types/pg": "8.15.5",
    "tsx": "4.22.4",
    "vitest": "4.1.8"
  }
}
