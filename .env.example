# Postgres 接続情報。docker-compose の既定値に合わせてある。
POSTGRES_USER=pokedex
POSTGRES_PASSWORD=pokedex
POSTGRES_DB=pokedex
POSTGRES_PORT=5432

# bff から Postgres への接続文字列。上の値と整合させる。
DATABASE_URL=postgres://pokedex:pokedex@localhost:5432/pokedex

# bff のリッスンポート。
PORT=3000

# 本番では production を指定する。指定時のみセッション Cookie に Secure 属性が付く。
NODE_ENV=development
