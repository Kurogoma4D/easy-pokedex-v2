# Postgres 接続情報。docker-compose の Postgres サービスと共有する。
# 個別変数は docker-compose のデフォルト（pokedex / pokedex / pokedex）に合わせている。
POSTGRES_USER=pokedex
POSTGRES_PASSWORD=pokedex
POSTGRES_DB=pokedex
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# 上記の個別変数の代わりに単一の接続文字列を指定することもできる（指定時はこちらが優先される）。
# DATABASE_URL=postgres://pokedex:pokedex@localhost:5432/pokedex

# セッション Cookie の署名・暗号化に用いる秘密鍵。十分に長いランダム文字列を設定する。
# 生成例: openssl rand -hex 32
SESSION_SECRET=change-me-to-a-long-random-string
